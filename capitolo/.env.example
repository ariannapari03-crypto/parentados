# Copia questo file in `.env` e riempi i valori. `.env` non entra nel repository.

# Postgres (Neon o Supabase). Il piano gratuito basta per i primi mesi.
# Neon: usa la connection string "Pooled" e tieni sslmode=require.
DATABASE_URL=postgresql://utente:password@ep-nome-1234-pooler.eu-central-1.aws.neon.tech/capitolo?sslmode=require

# Chiave API del modello, usata SOLO dai processi server-side (mai dal browser,
# mai committata). Serve dal compito ④ (estrazione) in avanti. [inv. 8]
ANTHROPIC_API_KEY=

# Password per l'interfaccia di revisione (compito ⑤).
REVISIONE_PASSWORD=

# URL pubblico del sito, per sitemap e link assoluti (es. https://capitolo.it).
# Su Vercel, in mancanza, si usa in automatico VERCEL_URL.
SITE_URL=
